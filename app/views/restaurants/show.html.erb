<h1><%= @restaurant.name %></h1>
<p><%= @restaurant.address %> · <%= @restaurant.phone_number %> · <%= @restaurant.category %></p>

<h3>Reviews</h3>
<% if @restaurant.reviews.empty? %>
  <p>No reviews yet.</p>
<% else %>
  <ul class="list-group mb-3">
    <% @restaurant.reviews.each do |review| %>
      <li class="list-group-item">⭐ <%= review.rating %>/5 — <%= review.content %></li>
    <% end %>
  </ul>
<% end %>

<%= link_to "Add a review", new_restaurant_review_path(@restaurant), class: "btn btn-primary" %>
