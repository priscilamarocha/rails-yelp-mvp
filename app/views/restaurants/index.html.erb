<h1>Restaurants</h1>
<% @restaurants.each do |restaurant| %>
  <div class="card mb-3">
    <div class="card-body">
      <h5 class="card-title"><%= restaurant.name %></h5>
      <p class="card-text"><%= restaurant.address %> · <%= restaurant.category %></p>
      <%= link_to "See details", restaurant_path(restaurant), class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
